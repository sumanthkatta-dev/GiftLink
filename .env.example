# Copy this file to .env.local and fill in the values from your Firebase
# service account key (Firebase console > Project settings > Service accounts).
# Never commit .env.local. Add the same three values in Vercel's Environment Variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private_key value, in double quotes, keeping the \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
