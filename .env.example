# Copy this file to .env.local and fill in the values from your Firebase
# service account key (Firebase console > Project settings > Service accounts).
# Never commit .env.local. Add the same three values in Vercel's Environment Variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private_key value, in double quotes, keeping the \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Safe Browsing (Lookup API v4). Links flagged as malware, phishing or
# unwanted software are refused. Optional: without it links aren't checked,
# and a warning is logged. Add the same value in Vercel's Environment Variables.
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional. Salt for hashing visitor IPs (rate limits, reports). If unset, a
# salt is derived from FIREBASE_PRIVATE_KEY, which is fine for most setups.
# IP_HASH_SALT=
